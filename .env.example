APP_NAME=SteamFinder
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# UI language: en | es | ru | he | zh  (APP_LANG also still works)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Required. Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The app stores nothing in a database. Sessions and cache are file-backed.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log

# Optional branding overrides. Leave empty to use public/brand-mark.svg.
FAVICON_URL=
BRAND_LOGO_URL=
